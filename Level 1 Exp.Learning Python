# Employee Payroll & Tax Management System

employees = []


# Add Employee
def add_employee():
    print("\n--- Add Employee ---")

    emp_id = input("Enter Employee ID: ")
    name = input("Enter Employee Name: ")
    department = input("Enter Department: ")
    basic_salary = float(input("Enter Basic Salary: "))
    bonus = float(input("Enter Bonus: "))

    employee = {
        "id": emp_id,
        "name": name,
        "department": department,
        "basic": basic_salary,
        "bonus": bonus
    }

    employees.append(employee)

    print("Employee added successfully!")


# Calculate Salary
def calculate_salary(employee):
    basic = employee["basic"]
    bonus = employee["bonus"]

    # Allowances
    hra = basic * 0.20       # 20% HRA
    travel = basic * 0.10    # 10% Travel Allowance

    # Deductions
    pf = basic * 0.12        # 12% Provident Fund
    tax = basic * 0.10       # 10% Income Tax

    total_allowance = hra + travel
    total_deduction = pf + tax

    gross_salary = basic + total_allowance + bonus
    net_salary = gross_salary - total_deduction

    return hra, travel, pf, tax, gross_salary, net_salary


# Display Employee Records
def display_employees():
    if len(employees) == 0:
        print("\nNo employee records found.")
        return

    print("\n--- Employee Records ---")

    for employee in employees:
        print("\nEmployee ID :", employee["id"])
        print("Name        :", employee["name"])
        print("Department  :", employee["department"])
        print("Basic Salary:", employee["basic"])
        print("Bonus       :", employee["bonus"])


# Generate Salary Slip
def salary_slip():
    emp_id = input("\nEnter Employee ID: ")

    for employee in employees:

        if employee["id"] == emp_id:

            hra, travel, pf, tax, gross, net = calculate_salary(employee)

            print("\n================================")
            print("         MONTHLY SALARY SLIP")
            print("================================")

            print("Employee ID :", employee["id"])
            print("Name        :", employee["name"])
            print("Department  :", employee["department"])

            print("\n--- Earnings ---")
            print("Basic Salary      :", employee["basic"])
            print("HRA               :", hra)
            print("Travel Allowance  :", travel)
            print("Bonus             :", employee["bonus"])
            print("Gross Salary      :", gross)

            print("\n--- Deductions ---")
            print("Provident Fund    :", pf)
            print("Income Tax        :", tax)
            print("Total Deduction   :", pf + tax)

            print("\nNet Salary        :", net)

            print("================================")

            return

    print("Employee not found.")


# Generate Payroll Report
def payroll_report():

    if len(employees) == 0:
        print("\nNo employee records found.")
        return

    print("\n========================================")
    print("             PAYROLL REPORT")
    print("========================================")

    for employee in employees:

        hra, travel, pf, tax, gross, net = calculate_salary(employee)

        print("\nEmployee ID :", employee["id"])
        print("Name        :", employee["name"])
        print("Department  :", employee["department"])
        print("Basic Salary:", employee["basic"])
        print("Gross Salary:", gross)
        print("Tax         :", tax)
        print("PF          :", pf)
        print("Net Salary  :", net)

    print("\n========================================")


# Main Menu
def main():

    while True:

        print("\n================================")
        print(" EMPLOYEE PAYROLL SYSTEM")
        print("================================")
        print("1. Add Employee")
        print("2. Display Employees")
        print("3. Generate Salary Slip")
        print("4. Generate Payroll Report")
        print("5. Exit")
        print("================================")

        choice = input("Enter your choice: ")

        if choice == "1":
            add_employee()

        elif choice == "2":
            display_employees()

        elif choice == "3":
            salary_slip()

        elif choice == "4":
            payroll_report()

        elif choice == "5":
            print("Thank you for using Payroll System!")
            break

        else:
            print("Invalid choice. Please try again.")


# Run the program
main()

